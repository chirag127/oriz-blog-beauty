---
import HeaderControls from '~/components/HeaderControls.tsx'
import MultiSearch from '~/components/MultiSearch.tsx'
import StatusBanner from '~/components/StatusBanner.astro'
/*
 * Header — Lumen MASTHEAD (editorial-magazine archetype).
 *
 *   ┌──────────────────────────────────────────────────────────────┐
 *   │  ISSUE Nº — The Regimen · Aug 2026            ⌘K · rss · ···   │  ← flag line
 *   │                                                                │
 *   │  L U M E N                                                     │  ← oversized logotype
 *   │  ─────────────────────────────────────────────────────────    │  ← contents rule
 *   │  THE FACE · INGREDIENTS · RITUALS · REVIEWS · ABOUT            │  ← index strip
 *   └──────────────────────────────────────────────────────────────┘
 *
 * NOT a centered top-nav pill bar. A print masthead: a mono flag line (issue +
 * date + controls), an oversized left-set Fraunces logotype with the gilt
 * dewdrop, then a hairline "contents" rule under a scrollable index strip.
 */
import Wordmark from '~/components/Wordmark.astro'

const now = new Date()
const issueDate = now.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' })
const p = Astro.url.pathname
const on = (seg: string) => (p === seg || (seg !== '/' && p.startsWith(seg)) ? 'page' : undefined)
---

<StatusBanner />
<header class="masthead" transition:persist="site-header">
  <div class="masthead-inner">
    <div class="flag">
      <span class="flag-issue mono">Nº 01 — The Regimen</span>
      <span class="flag-sep" aria-hidden="true">·</span>
      <span class="flag-date mono">{issueDate}</span>
      <div class="flag-controls">
        <div class="masthead-search"><MultiSearch client:idle /></div>
        <HeaderControls client:idle />
      </div>
    </div>

    <div class="logotype">
      <Wordmark size={72} href="/" />
      <p class="tagline">A beauty journal · skin that works, kept short</p>
    </div>

    <nav class="index-strip" aria-label="Primary">
      <a href="/" aria-current={on('/')}>The&nbsp;Face</a>
      <a href="/categories/" aria-current={on('/categories')}>Ingredients</a>
      <a href="/series/" aria-current={on('/series')}>Rituals</a>
      <a href="/tags/" aria-current={on('/tags')}>Reviews</a>
      <a href="/about/" aria-current={on('/about')}>About</a>
    </nav>
  </div>
</header>

<style>
  .masthead {
    position: relative;
    z-index: 40;
    background: var(--paper);
    border-bottom: 2px solid var(--ink);
  }
  .masthead-inner {
    max-width: 1200px;
    margin-inline: auto;
    padding: 0.75rem clamp(1rem, 4vw, 2.5rem) 0;
  }

  /* ── Flag line: issue · date · controls ─────────────────────────────── */
  .flag {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-block: 0.25rem 0.75rem;
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-utility);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .flag-issue { color: var(--accent); font-weight: 600; }
  .flag-sep { color: var(--rule-strong); }
  .flag-controls {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }
  .masthead-search { display: inline-flex; align-items: center; }

  /* ── Logotype: oversized, left-set, with tagline ────────────────────── */
  .logotype {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1.25rem;
    padding-block: clamp(0.75rem, 2.5vw, 1.5rem) 0.75rem;
  }
  .logotype :global(.wordmark) { font-size: clamp(2.75rem, 9vw, 4.5rem); }
  .tagline {
    margin: 0;
    font-family: var(--font-body);
    font-style: italic;
    font-size: clamp(0.9rem, 2vw, 1.05rem);
    color: var(--ink-mute);
  }

  /* ── Index strip: scrollable contents rule ──────────────────────────── */
  .index-strip {
    display: flex;
    gap: clamp(1rem, 3vw, 2.25rem);
    padding-block: 0.6rem 0.7rem;
    border-top: 1px solid var(--rule);
    overflow-x: auto;
    scrollbar-width: none;
    font-family: var(--font-utility);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .index-strip::-webkit-scrollbar { display: none; }
  .index-strip a {
    position: relative;
    color: var(--ink);
    text-decoration: none;
    padding-block: 0.1rem;
    transition: color var(--dur-fast) ease;
  }
  .index-strip a:hover { color: var(--accent); }
  .index-strip a[aria-current='page'] { color: var(--accent); }
  .index-strip a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: -0.7rem;
    height: 2px;
    background: var(--accent);
  }
</style>
