---
/**
 * IngredientSpotlight — Lumen signature component.
 *
 * Renders a cosmetic INCI-label panel: a bordered card that mimics the
 * ingredient-list aesthetic of a skincare product (monospaced ingredients
 * listed in descending concentration order). Used on the homepage to
 * surface key content categories in a beauty-native visual language.
 *
 * Props:
 *   title  — panel headline (e.g. "Active Ingredients")
 *   items  — array of { name, concentration, href, note? }
 *
 * Purely presentational; no JS required.
 */
export interface IngredientItem {
  name: string
  /** e.g. "30%" or a descriptive weight like "High" */
  concentration: string
  href: string
  note?: string
}

export interface Props {
  title?: string
  subtitle?: string
  items: IngredientItem[]
}

const { title = 'Active Ingredients', subtitle, items } = Astro.props
---

<aside class="inci-panel" aria-label={title}>
  <div class="inci-header">
    <p class="inci-label mono">INCI LIST</p>
    <h2 class="inci-title">{title}</h2>
    {subtitle && <p class="inci-sub">{subtitle}</p>}
  </div>
  <ol class="inci-list" role="list">
    {items.map((item, i) => (
      <li class="inci-row">
        <span class="inci-rank mono">{String(i + 1).padStart(2, '0')}</span>
        <a class="inci-name" href={item.href}>{item.name}</a>
        <span class="inci-conc mono" aria-label={`Concentration: ${item.concentration}`}>{item.concentration}</span>
        {item.note && <span class="inci-note">{item.note}</span>}
      </li>
    ))}
  </ol>
  <p class="inci-footer mono">In descending concentration · Lumen editorial</p>
</aside>

<style>
  .inci-panel {
    border: 1.5px solid var(--rule-strong);
    border-radius: var(--radius-card);
    padding: clamp(1.25rem, 3vw, 1.75rem);
    background: var(--paper-2);
    position: relative;
    overflow: hidden;
  }
  /* gilt top edge — the "active" band */
  .inci-panel::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--gilt) 0%, var(--accent) 100%);
    border-radius: var(--radius-card) var(--radius-card) 0 0;
  }

  .inci-header { margin-bottom: 1rem; }
  .inci-label {
    margin: 0 0 0.35rem;
    font-size: 9px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--gilt);
    font-weight: 700;
  }
  .inci-title {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2.5vw, 1.4rem);
    font-weight: 500;
    letter-spacing: -0.015em;
    margin: 0;
    color: var(--ink);
    line-height: 1.2;
  }
  .inci-sub {
    margin: 0.35rem 0 0;
    font-size: 0.875rem;
    color: var(--ink-mute);
    font-style: italic;
  }

  .inci-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .inci-row {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) auto;
    gap: 0.5rem 0.75rem;
    align-items: baseline;
    padding-block: 0.6rem;
    border-top: 1px solid var(--rule);
  }
  .inci-row:first-child { border-top: 0; }
  .inci-rank {
    font-size: 10px;
    color: var(--ink-mute);
    letter-spacing: 0.08em;
  }
  .inci-name {
    font-family: var(--font-display);
    font-size: 0.975rem;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
    letter-spacing: -0.008em;
  }
  .inci-name:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .inci-conc {
    font-size: 10px;
    letter-spacing: 0.08em;
    color: var(--accent);
    font-weight: 600;
    white-space: nowrap;
  }
  .inci-note {
    grid-column: 2 / -1;
    font-size: 0.8125rem;
    color: var(--ink-mute);
    font-style: italic;
    margin-top: -0.2rem;
  }

  .inci-footer {
    margin: 1rem 0 0;
    font-size: 9px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-mute);
    border-top: 1px solid var(--rule);
    padding-top: 0.75rem;
  }
</style>
