---
/**
 * PostCard — Lumen "shelf label" entry.
 *
 * Beauty-native aesthetic: each post is displayed like a product shelf label —
 * a soft tinted swatch, a cosmetic category badge (pill), a Fraunces headline,
 * a one-line dek, and a discreet mono foot. The hover reveals a gilt-accented
 * bottom border (like opening a product drawer).
 *
 * This is NOT the newspaper-row layout used by sibling blogs. No left-rule tick,
 * no grid kicker row. Shelves, not a ledger.
 */
import type { CollectionEntry } from 'astro:content'
import { formatPostDate, postVertical, slugifyTag, verticalLabel } from '~/lib/blog'

export interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props
const { title, description, pubDate, category, readingTime } = post.data
const href = `/blog/${post.id}`
const catHref = `/categories/${slugifyTag(category)}/`
const vert = postVertical(post)
---

<article class="shelf-card" data-vertical={vert}>
  <a class="shelf-link" href={href}>
    <span class="shelf-swatch" aria-hidden="true"></span>
    <span class="shelf-badge mono">{verticalLabel(vert)}</span>
    <h3 class="shelf-title">{title}</h3>
    <p class="shelf-dek">{description}</p>
    <span class="shelf-foot mono">
      <time datetime={pubDate.toISOString()}>{formatPostDate(pubDate)}</time>
      {readingTime && <span class="shelf-rt">{readingTime}</span>}
    </span>
  </a>
  <a class="shelf-cat-link" href={catHref} aria-label={`More in ${category}`}>{category}</a>
</article>

<style>
  .shelf-card {
    position: relative;
    --v: var(--v-personal);
    --swatch: color-mix(in oklab, var(--v) 12%, var(--paper-2));
    background: var(--paper-2);
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    overflow: hidden;
    transition: border-color var(--dur-fast) ease, box-shadow var(--dur-fast) ease;
  }
  .shelf-card[data-vertical='dev']     { --v: var(--v-dev); }
  .shelf-card[data-vertical='finance'] { --v: var(--v-finance); }
  .shelf-card[data-vertical='culture'] { --v: var(--v-culture); }
  .shelf-card[data-vertical='health']  { --v: var(--v-health); }
  .shelf-card:hover {
    border-color: var(--v);
    box-shadow: 0 2px 12px color-mix(in oklab, var(--v) 14%, transparent);
  }

  /* Tinted top swatch — like a product color-story band */
  .shelf-swatch {
    display: block;
    height: 5px;
    background: linear-gradient(90deg, var(--v) 0%, color-mix(in oklab, var(--v) 40%, var(--gilt)) 100%);
    border-radius: var(--radius-card) var(--radius-card) 0 0;
    transition: height var(--dur-fast) ease;
  }
  .shelf-card:hover .shelf-swatch { height: 8px; }

  .shelf-link {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1.125rem 1.25rem 1.25rem;
    text-decoration: none;
    color: var(--ink);
  }

  /* Pill badge — cosmetic category chip */
  .shelf-badge {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    padding: 0.18em 0.65em;
    border-radius: 999px;
    background: color-mix(in oklab, var(--v) 14%, var(--paper));
    color: var(--v);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    border: 1px solid color-mix(in oklab, var(--v) 28%, transparent);
  }

  .shelf-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.012em;
    line-height: 1.22;
    margin: 0;
    color: var(--ink);
  }
  .shelf-card:hover .shelf-title { color: var(--accent); }

  .shelf-dek {
    color: var(--ink-mute);
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0;
    max-width: 58ch;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    line-clamp: 2;
  }

  .shelf-foot {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--ink-mute);
    padding-top: 0.4rem;
    border-top: 1px solid var(--rule);
  }
  .shelf-rt::before {
    content: '·';
    margin-right: 0.6rem;
    color: var(--rule-strong, var(--rule));
  }

  /* Visually hidden category deep-link */
  .shelf-cat-link {
    position: absolute;
    inset: 0 0 auto auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .shelf-cat-link:focus-visible {
    width: auto;
    height: auto;
    clip: auto;
    top: 0.75rem;
    right: 0.75rem;
    padding: 0.125rem 0.5rem;
    background: var(--paper);
    border: 1px solid var(--accent);
    border-radius: 999px;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    text-decoration: none;
  }
</style>
