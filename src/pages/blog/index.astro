---
import PostCard from '~/components/blog/PostCard.astro'
/**
 * /blog — Lumen "The Shelf" — page 1 of the paginated blog index.
 * Pages 2+ live at /blog/page/[page].
 *
 * Layout: a tinted shelf-header (product-display aesthetic) + a masonry-style
 * multi-column card grid. Beauty-native: no ruled ledger rows, instead a
 * gallery of shelf-label cards in varying column weights.
 */
import BaseLayout from '~/layouts/BaseLayout.astro'
import { getAllCategories, getPublishedPosts, slugifyTag } from '~/lib/blog'
import { SITE_CONFIG } from '~/lib/config'

const PAGE_SIZE = 12

const allPosts = await getPublishedPosts()
const categories = await getAllCategories()
const totalPages = Math.max(1, Math.ceil(allPosts.length / PAGE_SIZE))
const posts = allPosts.slice(0, PAGE_SIZE)

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: `The Shelf — ${SITE_CONFIG.title}`,
  url: new URL('/blog/', SITE_CONFIG.url).toString(),
  description: 'Lumen — plain, tested skincare notes: minimal routines, reading ingredient labels, and caring for skin in Indian conditions.',
  author: {
    '@type': 'Person',
    name: SITE_CONFIG.author.name,
    url: SITE_CONFIG.author.url,
  },
}
---

<BaseLayout
  title="The Shelf — Lumen"
  description="Browse all skincare notes, routines, reviews, and ingredient guides."
  jsonLd={jsonLd}
>
  <div class="shelf-page">
    {/* ── Shelf header: tinted display band ─── */}
    <header class="shelf-head">
      <div class="shelf-head-copy">
        <p class="shelf-eyebrow mono">All notes</p>
        <h1 class="shelf-h1">The Shelf</h1>
        <p class="shelf-lede">Routines, ingredients, reviews — kept short.</p>
      </div>
      {categories.length > 0 && (
        <nav class="shelf-filters mono" aria-label="Filter by category">
          <a class="sf-pill is-active" href="/blog/">Everything</a>
          {categories.slice(0, 8).map((c) => (
            <a class="sf-pill" href={`/categories/${slugifyTag(c)}/`}>{c}</a>
          ))}
        </nav>
      )}
    </header>

    {/* ── Card gallery ──────────────────────── */}
    {posts.length === 0 ? (
      <p class="shelf-empty">First note drops shortly.</p>
    ) : (
      <ul class="shelf-grid" role="list">
        {posts.map((p) => (
          <li>
            <PostCard post={p} />
          </li>
        ))}
      </ul>
    )}

    {totalPages > 1 && (
      <nav class="shelf-pager mono" aria-label="Pagination">
        <span class="pager-info">Page 1 of {totalPages}</span>
        <a class="pager-next" href="/blog/page/2/" rel="next">Next page →</a>
      </nav>
    )}
  </div>
</BaseLayout>

<style>
  .shelf-page {
    max-width: 1100px;
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 2.5rem);
    padding-bottom: 4rem;
  }

  /* ── Shelf header ───────────────────────── */
  .shelf-head {
    padding-block: clamp(2rem, 5vw, 3rem) 1.5rem;
    border-bottom: 2px solid var(--ink);
    margin-bottom: 2rem;
  }
  .shelf-eyebrow {
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 0.6rem;
  }
  .shelf-h1 {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 6vw, 3.5rem);
    font-weight: 460;
    letter-spacing: -0.025em;
    line-height: 1.0;
    margin: 0 0 0.5rem;
    color: var(--ink);
  }
  .shelf-lede {
    color: var(--ink-mute);
    font-family: var(--font-body);
    font-style: italic;
    font-size: 1.05rem;
    margin: 0 0 1.5rem;
  }

  /* Category filter pills */
  .shelf-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.5rem;
  }
  .sf-pill {
    display: inline-block;
    padding: 0.3em 0.85em;
    border-radius: 999px;
    border: 1px solid var(--rule-strong);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-mute);
    background: transparent;
    transition: border-color var(--dur-fast) ease, color var(--dur-fast) ease,
      background var(--dur-fast) ease;
  }
  .sf-pill:hover,
  .sf-pill.is-active {
    border-color: var(--accent);
    color: var(--accent);
    background: color-mix(in oklab, var(--accent) 10%, transparent);
  }

  /* ── Card gallery — responsive 2–3 col grid ─ */
  .shelf-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 600px) {
    .shelf-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 960px) {
    .shelf-grid { grid-template-columns: repeat(3, 1fr); }
  }

  /* ── Pager ─────────────────────────────── */
  .shelf-pager {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
    font-size: 12px;
  }
  .pager-info { color: var(--ink-mute); letter-spacing: 0.06em; }
  .pager-next {
    padding: 0.45rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--rule-strong);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 11px;
    text-decoration: none;
    color: var(--ink);
    transition: border-color var(--dur-fast) ease, color var(--dur-fast) ease;
  }
  .pager-next:hover { border-color: var(--accent); color: var(--accent); }

  .shelf-empty { color: var(--ink-mute); }
</style>
