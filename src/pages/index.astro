---
import SeriesSpine from '~/components/SeriesSpine.astro'
/**
 * /  — Lumen COVER (editorial-magazine front page).
 *
 * Archetype: cover-image masthead + asymmetric magazine grid.
 *   1. COVER STORY — the lead post rendered as a full-bleed tinted cover panel
 *      with a large Fraunces headline (the "thesis" of this issue).
 *   2. CONTENTS GRID — a multi-column magazine grid: one wide feature well +
 *      secondary story wells of varying weight (no uniform card grid).
 *   3. DEPARTMENTS — series (in-progress) as a "featured departments" band.
 *   4. THE INDEX — categories as a masthead-style contents index footer.
 *
 * The Routine Ladder (ordered 01→04) rides along the cover as the signature
 * device; numbering is meaningful because a routine genuinely is sequential.
 */
import BaseLayout from '~/layouts/BaseLayout.astro'
import {
  getCategoriesWithCounts,
  getPostsInSeries,
  getPublishedPosts,
  getSeriesWithCounts,
  postVertical,
  readingTimeFor,
  slugifyTag,
  verticalFor,
  verticalLabel,
} from '~/lib/blog'
import { SITE_CONFIG } from '~/lib/config'

const allPosts = await getPublishedPosts()
const cover = allPosts[0]
const feature = allPosts[1]
const wells = allPosts.slice(2, 8)

const seriesAll = await getSeriesWithCounts()
type Dept = {
  name: string
  slug: string
  total: number
  published: number
  current: number
  latest: Date
}
const depts: Dept[] = []
for (const { series, count } of seriesAll.slice(0, 4)) {
  const parts = await getPostsInSeries(series)
  const latest = parts.reduce(
    (max, p) => (p.data.pubDate > max ? p.data.pubDate : max),
    parts[0].data.pubDate,
  )
  const explicitMax = parts.reduce((mx, p) => {
    const v = typeof p.data.part === 'number' ? p.data.part : Number(p.data.part)
    return Number.isFinite(v) ? Math.max(mx, v) : mx
  }, 0)
  const total = Math.max(count, explicitMax, count + 1)
  depts.push({ name: series, slug: slugifyTag(series), total, published: count, current: count, latest })
}
depts.sort((a, b) => b.latest.valueOf() - a.latest.valueOf())

const cats = await getCategoriesWithCounts()

const coverVertical = cover ? postVertical(cover) : 'personal'
const coverRt = cover ? (cover.data.readingTime ?? readingTimeFor(cover)) : ''
const iso = (d: Date) => d.toISOString().slice(0, 10)

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: SITE_CONFIG.title,
  url: `${SITE_CONFIG.url}/`,
  description: SITE_CONFIG.description,
  author: { '@type': 'Person', name: SITE_CONFIG.author.name, url: SITE_CONFIG.author.url },
}
---

<BaseLayout
  title="Lumen — the beauty journal"
  description={SITE_CONFIG.description}
  jsonLd={jsonLd}
  hideSidebar
>
  {/* ── COVER STORY ─────────────────────────────────────────────────── */}
  {cover && (
    <section class="cover" data-vertical={coverVertical} aria-labelledby="cover-title">
      <span class="cover-glow" aria-hidden="true"></span>
      <div class="cover-inner">
        <div class="cover-copy">
          <p class="cover-eyebrow mono">
            <span class="cover-dot" aria-hidden="true"></span>
            Cover story · {verticalLabel(coverVertical)}
          </p>
          <h1 id="cover-title" class="cover-title">
            <a href={`/blog/${cover.id}`}>{cover.data.title}</a>
          </h1>
          <p class="cover-dek">{cover.data.description}</p>
          <span class="cover-meta mono">
            <time datetime={cover.data.pubDate.toISOString()}>{iso(cover.data.pubDate)}</time>
            <span aria-hidden="true">·</span><span>{coverRt}</span>
            <a class="cover-cta" href={`/blog/${cover.id}`}>Read the story →</a>
          </span>
        </div>

        {/* Signature: the Routine Ladder — ordered, because a routine is. */}
        <aside class="cover-ladder" aria-label="The four-step routine">
          <p class="ladder-head mono">The four steps</p>
          <ol class="ladder">
            <li class="ladder-step"><span class="ladder-num mono">01</span><span class="ladder-name">Cleanse</span></li>
            <li class="ladder-step"><span class="ladder-num mono">02</span><span class="ladder-name">Treat</span></li>
            <li class="ladder-step"><span class="ladder-num mono">03</span><span class="ladder-name">Moisturise</span></li>
            <li class="ladder-step"><span class="ladder-num mono">04</span><span class="ladder-name">Protect</span></li>
          </ol>
        </aside>
      </div>
    </section>
  )}

  {/* ── CONTENTS: asymmetric magazine grid ──────────────────────────── */}
  <section class="contents" aria-labelledby="c-contents">
    <div class="section-rule">
      <h2 id="c-contents" class="section-h mono">In this issue</h2>
      <a class="section-more mono" href="/archive/">Full archive →</a>
    </div>

    <div class="grid">
      {feature && (
        <article class="well well-feature" data-vertical={postVertical(feature)}>
          <a class="well-link" href={`/blog/${feature.id}`}>
            <span class="well-kicker mono">
              <span class="well-tick" aria-hidden="true"></span>
              {verticalLabel(postVertical(feature))} · Feature
            </span>
            <h3 class="well-title">{feature.data.title}</h3>
            <p class="well-dek">{feature.data.description}</p>
            <span class="well-foot mono">
              <time datetime={feature.data.pubDate.toISOString()}>{iso(feature.data.pubDate)}</time>
              <span aria-hidden="true">·</span>
              <span>{feature.data.readingTime ?? readingTimeFor(feature)}</span>
            </span>
          </a>
        </article>
      )}

      {wells.map((p, i) => (
        <article class:list={['well', i === 0 && 'well-tall']} data-vertical={postVertical(p)}>
          <a class="well-link" href={`/blog/${p.id}`}>
            <span class="well-kicker mono">
              <span class="well-tick" aria-hidden="true"></span>
              {verticalLabel(postVertical(p))}
            </span>
            <h3 class="well-title">{p.data.title}</h3>
            <p class="well-dek">{p.data.description}</p>
            <span class="well-foot mono">
              <time datetime={p.data.pubDate.toISOString()}>{iso(p.data.pubDate)}</time>
              <span aria-hidden="true">·</span>
              <span>{p.data.readingTime ?? readingTimeFor(p)}</span>
            </span>
          </a>
        </article>
      ))}
    </div>
  </section>

  {/* ── DEPARTMENTS: series band ─────────────────────────────────────── */}
  {depts.length > 0 && (
    <section class="departments" aria-labelledby="c-depts">
      <div class="section-rule">
        <h2 id="c-depts" class="section-h mono">Departments</h2>
        <a class="section-more mono" href="/series/">All series →</a>
      </div>
      <ul class="dept-list">
        {depts.map((s) => (
          <li class="dept-row">
            <a class="dept-link" href={`/series/${s.slug}/`}>
              <span class="dept-name">{s.name}</span>
              <span class="dept-meta mono">part {s.published} of {s.total}</span>
              <span class="dept-spine"><SeriesSpine total={s.total} published={s.published} current={s.current} size="md" /></span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {/* ── THE INDEX: categories ────────────────────────────────────────── */}
  {cats.length > 0 && (
    <section class="the-index" aria-labelledby="c-index">
      <div class="section-rule">
        <h2 id="c-index" class="section-h mono">The index</h2>
      </div>
      <p class="index-row">
        {cats.map((c, i) => (
          <>
            {i > 0 && <span class="index-slash" aria-hidden="true">/</span>}
            <a href={`/categories/${slugifyTag(c.category)}/`} class="index-link" data-vertical={verticalFor(c.category)}>
              <span class="index-name">{c.category}</span><span class="index-count mono">{c.count}</span>
            </a>
          </>
        ))}
      </p>
    </section>
  )}
</BaseLayout>

<style>
  .cover,
  .contents,
  .departments,
  .the-index {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 2.5rem);
  }

  /* ── Cover story ────────────────────────────────────────────────────── */
  .cover {
    --v: var(--v-personal);
    position: relative;
    isolation: isolate;
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
    padding: clamp(1.75rem, 4vw, 3rem);
    border: 1px solid var(--rule);
    border-top: 3px solid var(--v);
    border-radius: var(--radius-card);
    background: var(--paper-2);
    overflow: hidden;
  }
  .cover[data-vertical='dev'] { --v: var(--v-dev); }
  .cover[data-vertical='finance'] { --v: var(--v-finance); }
  .cover[data-vertical='culture'] { --v: var(--v-culture); }
  .cover[data-vertical='health'] { --v: var(--v-health); }
  /* dewdrop glow — the dewy luminosity, one instance, standing in for cover art */
  .cover-glow {
    position: absolute;
    z-index: -1;
    top: -20%;
    right: -8%;
    width: clamp(280px, 46vw, 560px);
    height: clamp(280px, 46vw, 560px);
    border-radius: 50%;
    background: radial-gradient(closest-side,
      color-mix(in oklab, var(--accent) 26%, transparent) 0%,
      color-mix(in oklab, var(--gilt) 14%, transparent) 46%,
      transparent 72%);
    filter: blur(6px);
    pointer-events: none;
  }
  .cover-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }
  @media (min-width: 860px) {
    .cover-inner { grid-template-columns: minmax(0, 1fr) 15rem; align-items: end; }
  }
  .cover-eyebrow {
    display: inline-flex; align-items: center; gap: 0.5rem;
    margin: 0 0 1.25rem;
    font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; font-weight: 600;
    color: var(--ink-mute);
  }
  .cover-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--v);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--v) 20%, transparent);
    flex: 0 0 auto;
  }
  .cover-title {
    font-family: var(--font-display);
    font-weight: 380;
    font-size: clamp(2.2rem, 6.5vw, 4rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0;
    max-width: 16ch;
  }
  .cover-title a { color: inherit; text-decoration: none; }
  .cover-title a:hover { color: var(--accent); }
  .cover-dek {
    font-family: var(--font-body);
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    line-height: 1.55;
    color: var(--ink-mute);
    margin: 1.4rem 0 0;
    max-width: 52ch;
  }
  .cover-meta {
    display: inline-flex; flex-wrap: wrap; align-items: center; gap: 0.6rem;
    margin-top: 1.5rem;
    font-size: 11px; letter-spacing: 0.08em; color: var(--ink-mute);
  }
  .cover-cta {
    color: var(--accent); text-decoration: none; font-weight: 600;
    border-left: 1px solid var(--rule); padding-left: 0.6rem; margin-left: 0.2rem;
  }
  .cover-cta:hover { text-decoration: underline; text-underline-offset: 3px; }

  /* Routine Ladder — vertical stack in the cover rail */
  .cover-ladder { align-self: end; }
  .ladder-head {
    margin: 0 0 0.75rem;
    font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-mute);
  }
  .ladder { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  .ladder-step {
    display: inline-flex; align-items: center; gap: 0.6rem;
    padding: 0.5rem 0.85rem;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: var(--radius-button);
    box-shadow: 0 1px 0 color-mix(in oklab, var(--gilt) 22%, transparent);
    transition: transform var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);
  }
  .ladder-num {
    font-size: 11px; font-weight: 700; color: var(--accent);
    background: var(--brand-soft); border-radius: 999px; padding: 0.16em 0.5em;
  }
  .ladder-name { font-family: var(--font-display); font-size: 0.95rem; font-weight: 500; color: var(--ink); }
  @media (prefers-reduced-motion: no-preference) {
    .ladder-step:hover { transform: translateX(3px); border-color: var(--rule-strong); }
  }

  /* ── Section rules ────────────────────────────────────────────────── */
  .contents, .departments { margin-top: clamp(2.5rem, 6vw, 4rem); }
  .the-index { margin-top: clamp(2rem, 5vw, 3rem); }
  .section-rule {
    display: flex; align-items: baseline; justify-content: space-between; gap: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--ink);
    margin-bottom: 1.5rem;
  }
  .section-h {
    margin: 0;
    font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; font-weight: 600;
    color: var(--ink);
  }
  .section-more { font-size: 11px; letter-spacing: 0.1em; color: var(--ink-mute); text-decoration: none; }
  .section-more:hover { color: var(--accent); }

  /* ── Magazine grid: asymmetric wells ──────────────────────────────── */
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }
  @media (min-width: 720px) {
    .grid { grid-template-columns: repeat(2, 1fr); column-gap: clamp(1.5rem, 3vw, 2.5rem); }
    .well-feature { grid-column: 1 / -1; }
  }
  @media (min-width: 1000px) {
    .grid { grid-template-columns: repeat(3, 1fr); }
    .well-feature { grid-column: 1 / 3; grid-row: span 2; }
    .well-tall { grid-row: span 2; }
  }

  .well {
    --v: var(--v-personal);
    border-top: 1px solid var(--rule);
  }
  .well[data-vertical='dev'] { --v: var(--v-dev); }
  .well[data-vertical='finance'] { --v: var(--v-finance); }
  .well[data-vertical='culture'] { --v: var(--v-culture); }
  .well[data-vertical='health'] { --v: var(--v-health); }
  .well-feature {
    border-top: 3px solid var(--v);
    background: var(--paper-2);
    border-radius: var(--radius-card);
    border-bottom: 1px solid var(--rule);
    border-left: 1px solid var(--rule);
    border-right: 1px solid var(--rule);
    margin-bottom: 1.5rem;
  }
  .well-link {
    display: flex; flex-direction: column; gap: 0.6rem;
    height: 100%;
    padding: 1.25rem 0 1.5rem;
    color: var(--ink); text-decoration: none;
    border-left: 2px solid transparent; margin-left: -0.9rem; padding-left: 0.9rem;
    transition: border-color var(--dur-fast) ease;
  }
  .well-feature .well-link {
    padding: clamp(1.5rem, 3vw, 2.25rem);
    margin-left: 0; border-left: 0;
  }
  .well-link:hover { border-left-color: var(--v); }
  .well-feature .well-link:hover { border-left-color: transparent; }
  .well-kicker {
    display: inline-flex; align-items: center; gap: 0.4rem;
    font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 500;
    color: var(--v);
  }
  .well-tick { width: 6px; height: 6px; background: var(--v); flex: 0 0 auto; }
  .well-title {
    font-family: var(--font-display);
    font-weight: 560;
    font-size: 1.3rem;
    line-height: 1.18;
    letter-spacing: -0.012em;
    margin: 0;
    color: var(--ink);
  }
  .well-feature .well-title { font-weight: 420; font-size: clamp(1.75rem, 3.4vw, 2.6rem); max-width: 20ch; }
  .well-link:hover .well-title { color: var(--accent); }
  .well-dek {
    font-family: var(--font-body);
    font-size: 0.95rem; line-height: 1.5; color: var(--ink-mute);
    margin: 0; max-width: 60ch;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; line-clamp: 3; overflow: hidden;
  }
  .well-feature .well-dek { font-size: 1.075rem; -webkit-line-clamp: 4; line-clamp: 4; }
  .well-foot {
    margin-top: auto;
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-size: 11px; letter-spacing: 0.06em; color: var(--ink-mute);
    padding-top: 0.6rem;
  }

  /* ── Departments ──────────────────────────────────────────────────── */
  .dept-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .dept-row { border-bottom: 1px solid color-mix(in oklab, var(--rule) 70%, transparent); }
  .dept-row:last-child { border-bottom: 0; }
  .dept-link {
    display: grid; grid-template-columns: minmax(0, 1fr) auto auto; gap: 1rem;
    align-items: baseline; padding-block: 0.9rem;
    color: var(--ink); text-decoration: none;
  }
  .dept-link:hover .dept-name, .dept-link:hover .dept-meta { color: var(--accent); }
  .dept-name {
    font-family: var(--font-display); font-size: 1.15rem; font-weight: 600; letter-spacing: -0.01em;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .dept-meta { font-size: 11px; letter-spacing: 0.06em; color: var(--ink-mute); }
  .dept-spine { display: inline-flex; }
  @media (max-width: 560px) {
    .dept-link { grid-template-columns: minmax(0, 1fr) auto; }
    .dept-spine { grid-column: 1 / -1; }
  }

  /* ── The index ────────────────────────────────────────────────────── */
  .index-row { margin: 0; line-height: 2.2; }
  .index-link { --v: var(--v-personal); text-decoration: none; color: var(--ink); }
  .index-link[data-vertical='dev'] { --v: var(--v-dev); }
  .index-link[data-vertical='finance'] { --v: var(--v-finance); }
  .index-link[data-vertical='culture'] { --v: var(--v-culture); }
  .index-link[data-vertical='health'] { --v: var(--v-health); }
  .index-link:hover .index-name { color: var(--v); }
  .index-name { font-family: var(--font-display); font-size: 1.15rem; font-weight: 500; letter-spacing: -0.01em; }
  .index-count {
    font-size: 10px; color: var(--ink-mute); vertical-align: super; margin-left: 0.15rem;
  }
  .index-slash { color: var(--rule-strong); margin-inline: 0.6rem; }
</style>
